@model IEnumerable<CarApp.Models.Car>

<div class="container mt-4">
    <div class="card p-3">
        <h2 class="mb-4 text-white">List of Cars</h2>

        <table class="table table-dark table-striped table-hover custom-dark-table">
            <thead>
                <tr>
                    <th>Car ID</th>
                    <th>Car Brand</th>
                    <th>Car Model</th>
                    <th>Description</th>
                    <th>Price (PHP)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.CarId</td>
                        <td>@car.CarBrand</td>
                        <td>@car.CarModel</td>
                        <td>@car.CarDescription</td>
                        <td>@car.CarPrice.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a href="@Url.Action("Add", "Cars")" class="btn btn-primary">Add a Car</a>
        </div>
    </div>
</div>