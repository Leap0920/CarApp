@model IEnumerable<CarApp.Models.Car>

<div class="card">
    <h2 class="mb-4">List of Cars</h2>

    <table class="table-dark">
        <tr>
            <th>Car ID</th>
            <th>Car Brand</th>
            <th>Car Model</th>
            <th>Car Description</th>
            <th>Car Price (PHP)</th>
        </tr>
        @foreach (var car in Model)
        {
            <tr>
                <td>@car.CarId</td>
                <td>@car.CarBrand</td>
                <td>@car.CarModel</td>
                <td>@car.CarDescription</td>
                <td>@car.CarPrice</td>
            </tr>
        }
    </table>

    <div class="mt-3">
        <a href="@Url.Action("Add", "Cars")" class="btn btn-primary">Add a Car</a>
    </div>
</div>
