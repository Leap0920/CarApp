@model CarApp.Models.Car

@{
    ViewBag.Title = "Add a Car";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <!-- Left side: Add Form -->
        <div class="col-md-6">
            <div class="card p-4">
                <h2 class="text-center mb-4">Add a Car</h2>

                @using (Html.BeginForm("Add", "Cars", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    <div class="mb-3">
                        <label class="form-label">Car Brand</label>
                        @Html.TextBoxFor(m => m.CarBrand, new { @class = "form-control", placeholder = "Enter car brand", @id = "CarBrand" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Car Model</label>
                        @Html.TextBoxFor(m => m.CarModel, new { @class = "form-control", placeholder = "Enter car model", @id = "CarModel" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Car Description</label>
                        @Html.TextAreaFor(m => m.CarDescription, new { @class = "form-control", placeholder = "Enter description", rows = 3, @id = "CarDescription" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Car Price (PHP)</label>
                        @Html.TextBoxFor(m => m.CarPrice, new { @class = "form-control", placeholder = "Enter price", @id = "CarPrice" })
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary px-4">Save</button>
                        <a href="@Url.Action("List", "Cars")" class="btn btn-secondary px-4">Cancel</a>
                    </div>
                }
            </div>
        </div>

        <!-- Right side: Car Details Preview -->
        <div class="col-md-6">
            <div class="card p-4">
                <h3>Car Details</h3>
                <p><strong>Car Brand:</strong> <span id="previewBrand">-</span></p>
                <p><strong>Car Model:</strong> <span id="previewModel">-</span></p>
                <p><strong>Description:</strong> <span id="previewDescription">-</span></p>
                <p><strong>Price (PHP):</strong> <span id="previewPrice">-</span></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>// Live preview as user types
        document.getElementById("CarBrand").addEventListener("input", function () {
            document.getElementById("previewBrand").innerText = this.value || "-";
        });
        document.getElementById("CarModel").addEventListener("input", function () {
            document.getElementById("previewModel").innerText = this.value || "-";
        });
        document.getElementById("CarDescription").addEventListener("input", function () {
            document.getElementById("previewDescription").innerText = this.value || "-";
        });
        document.getElementById("CarPrice").addEventListener("input", function () {
            document.getElementById("previewPrice").innerText = this.value || "-";
        });</script>
}