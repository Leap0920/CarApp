@model CarApp.Models.Car

@{
    ViewBag.Title = "Add a Car";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    <div class="col-md-6">
        <div class="card p-4">
            <h2 class="text-center mb-4">Add a Car</h2>

            @using (Html.BeginForm("Add", "Cars", FormMethod.Post, new { @class = "needs-validation" }))
            {
                <div class="mb-3">
                    <label class="form-label">Car Brand</label>
                    @Html.TextBoxFor(m => m.CarBrand, new { @class = "form-control", placeholder = "Enter car brand" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Car Model</label>
                    @Html.TextBoxFor(m => m.CarModel, new { @class = "form-control", placeholder = "Enter car model" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Car Description</label>
                    @Html.TextAreaFor(m => m.CarDescription, new { @class = "form-control", placeholder = "Enter description", rows = 3 })
                </div>

                <div class="mb-3">
                    <label class="form-label">Car Price (PHP)</label>
                    @Html.TextBoxFor(m => m.CarPrice, new { @class = "form-control", placeholder = "Enter price" })
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                    <a href="@Url.Action("List", "Cars")" class="btn btn-secondary px-4">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>
